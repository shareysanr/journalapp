generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int              @id @default(autoincrement())
  cognitoSub      String           @unique @map("cognito_sub")
  createdAt       DateTime         @default(now()) @map("created_at")
  entries         Entry[]
  reports         WeeklyReport[]
  recurringGoals       RecurringGoal[]
  goalCompletions      GoalCompletion[]
  achievementUnlocks   AchievementUnlock[]

  @@map("users")
}

model Entry {
  id                 Int      @id @default(autoincrement())
  userId             Int      @map("user_id")
  date               DateTime @db.Date
  goalsPlanned       String   @map("goals_planned")
  numGoals           Int      @map("num_goals")
  goalsCompleted     Int      @map("goals_completed")
  distractions       String[]
  negativeComponents String[] @map("negative_components")
  positiveComponents String[] @map("positive_components")
  difficulty         Int
  rating             Int
  mood               Int?
  motivation         Int?
  notes              String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("entries")
}

model WeeklyReport {
  id                       Int      @id @default(autoincrement())
  userId                   Int      @map("user_id")
  weekStartDate            DateTime @db.Date @map("week_start_date")
  weekEndDate              DateTime @db.Date @map("week_end_date")
  summary                  String
  recommendations          String
  accomplishments          Int
  failures                 Int
  averageRating            Float    @map("average_rating")
  commonDistractions       String[] @map("common_distractions")
  commonNegativeComponents String[] @map("common_negative_components")
  commonPositiveComponents String[] @map("common_positive_components")
  entryIds                 Int[]    @map("entry_ids")
  createdAt                DateTime @default(now()) @map("created_at")
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStartDate, weekEndDate])
  @@map("weekly_reports")
}

model RecurringGoal {
  id          Int              @id @default(autoincrement())
  userId      Int              @map("user_id")
  title       String
  description String?
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions GoalCompletion[]

  @@index([userId])
  @@map("recurring_goals")
}

model GoalCompletion {
  id        Int           @id @default(autoincrement())
  goalId    Int           @map("goal_id")
  userId    Int           @map("user_id")
  date      DateTime      @db.Date
  createdAt DateTime      @default(now()) @map("created_at")
  goal      RecurringGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([goalId, date])
  @@index([userId, date])
  @@index([goalId, date])
  @@map("goal_completions")
}

model AchievementDefinition {
  id          Int                 @id @default(autoincrement())
  key         String              @unique
  title       String
  description String
  category    String
  icon        String
  sortOrder   Int                 @map("sort_order")
  createdAt   DateTime            @default(now()) @map("created_at")
  unlocks     AchievementUnlock[]

  @@index([category, sortOrder])
  @@map("achievement_definitions")
}

model AchievementUnlock {
  id                      Int                   @id @default(autoincrement())
  userId                  Int                   @map("user_id")
  achievementDefinitionId Int                   @map("achievement_definition_id")
  unlockedAt              DateTime              @default(now()) @map("unlocked_at")
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementDefinition   AchievementDefinition @relation(fields: [achievementDefinitionId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementDefinitionId])
  @@index([userId])
  @@index([achievementDefinitionId])
  @@index([unlockedAt])
  @@map("achievement_unlocks")
}
