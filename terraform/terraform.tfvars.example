# Copy to terraform.tfvars (gitignored) and fill with values from AWS Console / CLI.
# Then import — do not apply first.

aws_region   = "us-east-2"
project_name = "clarity"

# EC2 — aws ec2 describe-instances
instance_id       = "i-xxxxxxxxxxxxxxxxx"
ami_id            = "ami-xxxxxxxxxxxxxxxxx"
instance_type     = "t3.micro"
subnet_id         = "subnet-xxxxxxxx"
security_group_id = "sg-xxxxxxxx"
key_name          = "" # existing key pair name, or leave empty

# Elastic IP — only if Console shows an Elastic IP on this instance.
# aws ec2 describe-addresses
# Leave empty to skip EIP (do not create a new one).
eip_allocation_id = "" # e.g. "eipalloc-xxxxxxxx"

# Cognito — must match backend COGNITO_* env (pool id + client id, not the secret)
cognito_user_pool_id          = "us-east-2_XXXXXXXXX"
cognito_user_pool_name        = "existing-pool-name"
cognito_user_pool_client_id   = "xxxxxxxxxxxxxxxxxxxxxxxxxx"
cognito_user_pool_client_name = "existing-client-name"
cognito_generate_secret       = true
